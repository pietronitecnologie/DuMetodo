# Configurazione di MetodoConsole: copiala in /etc/metodoconsole/metodoconsole.conf (lo fa installa.sh).

[metodo]
# Cartella di Metodo v2 sul server (quella con compose.yaml e .env).
cartella = /opt/metodo
# File compose usati in produzione, separati da spazi (es. compose.yaml compose.produzione.yaml).
file_compose = compose.yaml
# Nome del progetto Docker Compose (vuoto = quello di compose.yaml: metodo).
progetto =
# Indirizzo con cui gli utenti raggiungono Metodo v2: se indicato si controllano risposta e certificato https.
url_pubblico =
db_nome = metodo
db_utente = metodo

[backup]
cartella = /var/backups/metodo
# Rotazione: si tiene l'ultimo backup di ognuno degli ultimi N giorni, N settimane, N mesi.
conserva_giornalieri = 14
conserva_settimanali = 8
conserva_mensili = 12
# Oltre questa età l'ultimo backup è segnalato dalla diagnostica.
massima_eta_ore = 26
# Copia dei backup su un altro computer con rsync (consigliato: un backup sullo stesso disco non protegge
# da un guasto del disco). Es. backup@nas.azienda.local:/backup/metodo  (serve una chiave SSH senza password)
copia_remota =
# Spazio libero minimo sui dischi prima di segnalarlo.
spazio_minimo_gb = 5

[avvisi]
# Email ai destinatari di Metodo v2 → Configurazione → Indirizzi email → «Destinatari avvisi del server».
email = si
# Finché un problema dura, l'avviso si ripete ogni N ore.
ripeti_ore = 6
# Da che livello mandare l'email: attenzione (anche gli avvisi, es. aggiornamenti in attesa) o errore.
livello = attenzione
# Server senza Metodo v2 (o se Metodo v2 non riesce a spedire): a chi mandare gli avvisi, tramite il sendmail
# locale (Postfix o Exim). Separati da virgole.
destinatari =
cartella_stato = /var/lib/metodoconsole

# ============================================================================== diagnostica per aree
# «metodoconsole diagnostica --elenco» mostra le aree e quali ha trovato sul server. Tutte le sezioni qui sotto
# sono facoltative: senza, ogni area si attiva da sola se trova ciò che controlla.

[diagnostica]
# auto = tutte quelle trovate; oppure un elenco, es.: sistema sicurezza web posta database django docker
aree = auto
# Porte che è normale vedere aperte a Internet (le altre vengono segnalate). Quelle dei database (5432, 3306,
# 6379…) sono sempre segnalate.
porte_attese = 22,25,53,80,110,143,443,465,587,993,995

[web]
# Siti da controllare (risposta, redirect https, intestazioni, certificato). Vuoto = quelli in ascolto su 443
# nella configurazione di nginx.
url =

[posta]
# Domini di cui controllare MX, SPF, DMARC e DKIM (vuoto = mydomain di Postfix).
domini =
# Selettori DKIM da cercare (nome._domainkey.dominio).
dkim_selettori = default dkim mail
# Nome del server di posta nei certificati (vuoto = myhostname di Postfix).
host =
# Indirizzo pubblico da controllare nelle liste nere, se il server è dietro NAT.
ip =

# Applicazioni Django senza container. Quelle avviate da systemd con gunicorn/uwsgi/daphne/uvicorn si trovano
# da sole; qui si aggiungono o si completano (una sezione per applicazione):
# [app:metodo1]
# cartella = /root/Metodo
# python = /root/Metodo/venv/bin/python
# servizio = gunicorn_metodo
# url = https://metodo.esempio.it/
# utente = root
