[Unit]
Description=MetodoConsole: ponte dal Docker di Metodo v2 al database del vecchio Metodo (solo per l'allineamento)
# L'indirizzo 172.17.0.1 (rete di Docker) esiste solo con Docker avviato: il ponte non è raggiungibile da fuori.
After=docker.service
Requires=docker.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:15432,bind=172.17.0.1,reuseaddr,fork TCP:127.0.0.1:5432
Restart=on-failure
RestartSec=10
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
