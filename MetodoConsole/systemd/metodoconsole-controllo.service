[Unit]
Description=MetodoConsole: diagnostica del server (e di Metodo v2, se installato)
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/metodoconsole diagnostica --avvisa --silenzioso
# 1 = attenzione, 2 = errore: sono esiti del controllo, non guasti del servizio di controllo.
SuccessExitStatus=1 2
