# Copia in .env e compila. Il file .env NON va mai su git.
DJANGO_SECRET_KEY=cambia-questa-chiave-con-una-lunga-e-casuale
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=dumetodo.esempio.it
DJANGO_CSRF_TRUSTED_ORIGINS=https://dumetodo.esempio.it
SITE_URL=https://dumetodo.esempio.it

POSTGRES_PASSWORD=cambia-questa-password
DATABASE_URL=postgres://dumetodo:cambia-questa-password@db:5432/dumetodo
CACHE_URL=rediscache://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0

# Email in uscita (ex EMAIL_SERVER / EMAIL_METODO_USER / EMAIL_METODO_PASSWORD)
EMAIL_HOST=smtp.esempio.it
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=metodo@esempio.it

# Casella da cui arrivano gli ordini: di norma si imposta dall'app (Configurazione > Casella ordini),
# dove la password è salvata cifrata. Questi valori valgono solo se lì il server è vuoto.
ORDINI_IMAP_HOST=
ORDINI_IMAP_PORT=993
ORDINI_IMAP_USER=
ORDINI_IMAP_PASSWORD=
ORDINI_IMAP_FOLDER=INBOX
# Facoltativa: chiave per cifrare le password salvate dall'app (se manca si usa DJANGO_SECRET_KEY).
# Se cambia, le password salvate vanno reinserite in Configurazione.
# DUMETODO_CHIAVE_SEGRETI=
